/// Trocas de programa; tempo de troca = última placa do programa anterior até a primeira do novo.
table TrocaPrograma
	lineageTag: 83036e04-a6cb-51af-b0a8-db3b410f41b5

	measure Trocas = COUNTROWS ( TrocaPrograma )
		formatString: #,0
		displayFolder: Trocas
		lineageTag: 148a477f-95e9-52a6-9ba3-d01e3b2a0a3c

	measure 'Tempo Médio de Troca (min)' = AVERAGE ( TrocaPrograma[MinutosTroca] )
		formatString: #,0.0
		displayFolder: Trocas
		lineageTag: 01792345-5183-5148-8c0d-2d18a908fb09

	measure 'Tempo Total de Troca (h)' = DIVIDE ( SUM ( TrocaPrograma[MinutosTroca] ), 60 )
		formatString: #,0.0
		displayFolder: Trocas
		lineageTag: afa87479-ef8e-562f-8fef-51041521e66e

