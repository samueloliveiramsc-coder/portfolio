/// Falhas de coleta, falhas de consumo (feeder não encontrado) e interlocks.
table Evento
	lineageTag: d3b07c0d-c27c-5e56-b07f-0c87e47e6977

	measure Eventos = COUNTROWS ( Evento )
		formatString: #,0
		displayFolder: Eventos
		lineageTag: 6bc98ef2-8e50-58d6-9486-6aa3d3a8d6c8

	measure 'Falhas de Coleta' = CALCULATE ( [Eventos], Evento[TipoEvento] = "Falha de coleta" )
		formatString: #,0
		displayFolder: Eventos
		lineageTag: 28882d09-0d77-5cd3-a2e4-7412cc6afae4

	measure 'Falhas de Consumo' = CALCULATE ( [Eventos], Evento[TipoEvento] = "Falha de consumo" )
		formatString: #,0
		displayFolder: Eventos
		lineageTag: 55009679-dbcb-5b91-a440-cd571a7ccc92

	measure Interlocks = CALCULATE ( [Eventos], Evento[TipoEvento] = "Interlock" )
		formatString: #,0
		displayFolder: Eventos
		lineageTag: 48db1817-4f38-575c-9471-e9b65fc89060

