/// Falhas das máquinas KE: leituras consecutivas com TimeTrouble ou TimeRepair. Paradas menores que o intervalo de coleta não aparecem.
table FalhaMaquina
	lineageTag: 4f63f4ef-2ffb-51b8-9ac9-339fbf8ac2fb

	/// Paradas por falha/reparo a partir de FALHA_MIN_MINUTOS (padrão 5 min), pela data de início.
	measure Falhas = CALCULATE ( COUNTROWS ( FalhaMaquina ), FalhaMaquina[Tipo] = "Falha" )
		formatString: #,0
		displayFolder: Confiabilidade
		lineageTag: 59668f1b-2546-5c3a-a4db-1e8327a11a8b

	/// Paradas por falha/reparo mais curtas que FALHA_MIN_MINUTOS: perda de desempenho, fora do MTBF/MTTR.
	measure Microparadas = CALCULATE ( COUNTROWS ( FalhaMaquina ), FalhaMaquina[Tipo] = "Microparada" )
		formatString: #,0
		displayFolder: Confiabilidade
		lineageTag: 43824483-9630-57db-b529-c58a2aad533d

	measure 'Tempo em Falha (h)' = DIVIDE ( CALCULATE ( SUM ( FalhaMaquina[MinutosParada] ), FalhaMaquina[Tipo] = "Falha" ), 60 )
		formatString: #,0.0
		displayFolder: Confiabilidade
		lineageTag: 71b98b3e-a130-55d2-80db-cc9434817129

	/// Horas rodando ÷ falhas. Em branco quando não houve falha no período; precisa de semanas de histórico para ser estável.
	measure 'MTBF (h)' = DIVIDE ( [Horas Rodando], [Falhas] )
		formatString: #,0.0
		displayFolder: Confiabilidade
		lineageTag: b5a9b43d-9773-5677-bcb4-e4e19738089d

	/// Minutos parados por falha ÷ falhas. Inclui a espera pelo técnico (a origem não separa espera de reparo).
	measure 'MTTR (min)' = DIVIDE ( [Tempo em Falha (h)] * 60, [Falhas] )
		formatString: #,0.0
		displayFolder: Confiabilidade
		lineageTag: 4b205a2c-edf1-56c8-b2a2-862d673856bd

