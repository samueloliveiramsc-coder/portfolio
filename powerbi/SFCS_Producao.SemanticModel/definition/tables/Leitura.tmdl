/// Uma linha por leitura SPEND (~2 min) sem repetidas; valores = diferença desde a leitura anterior.
table Leitura
	lineageTag: 4531ce15-8ed7-5ae9-b934-b05c57903125

	/// Placas produzidas pela linha: a maior contagem entre as máquinas da linha (a mesma placa passa por todas). Por máquina, é a contagem da própria máquina.
	measure Placas = SUMX ( VALUES ( Maquina[Linha] ), CALCULATE ( MAXX ( VALUES ( Maquina[MaquinaKey] ), CALCULATE ( SUM ( Leitura[QtdPlacas] ) ) ) ) )
		formatString: #,0
		displayFolder: Produção
		lineageTag: c835fed7-8235-52ac-be59-eac2675b93b7

	/// Soma das placas de cada máquina: uma placa conta uma vez em cada máquina por onde passa.
	measure 'Placas Processadas' = SUM ( Leitura[QtdPlacas] )
		formatString: #,0
		displayFolder: Produção
		lineageTag: 2ec77cdf-0abf-5060-a090-5f20c8956c14

	/// Componentes coletados (StoreNum.Pick).
	measure Pick = SUM ( Leitura[QtdPick] )
		formatString: #,0
		displayFolder: Produção
		lineageTag: 77af04e7-4dc5-5cc0-ac4c-712d9dcd68eb

	/// Componentes montados (StoreNum.Place).
	measure Place = SUM ( Leitura[QtdPlace] )
		formatString: #,0
		displayFolder: Produção
		lineageTag: 2a8e863a-6008-523c-b994-7df01c53e4b7

	measure 'Componentes por Placa' = DIVIDE ( [Place], [Placas] )
		formatString: #,0.0
		displayFolder: Produção
		lineageTag: 07207b40-a034-5e2b-b400-bfc9e429df7a

	/// TimeRun, só máquinas KE.
	measure 'Horas Rodando' = DIVIDE ( SUM ( Leitura[TempoRodando] ), 3600 )
		formatString: #,0.0
		displayFolder: Disponibilidade
		lineageTag: eedeedf9-7242-595c-991a-5f94df159250

	/// TimeDown, só máquinas KE.
	measure 'Horas Paradas' = DIVIDE ( SUM ( Leitura[TempoParado] ), 3600 )
		formatString: #,0.0
		displayFolder: Disponibilidade
		lineageTag: d11d57bb-d556-54a3-83c3-6b0df62b6940

	/// Rodando ÷ (Rodando + Parado). Em branco para máquinas que não informam tempos (SIG/HT).
	measure 'Disponibilidade %' = DIVIDE ( SUM ( Leitura[TempoRodando] ), SUM ( Leitura[TempoRodando] ) + SUM ( Leitura[TempoParado] ) )
		formatString: 0.0%
		displayFolder: Disponibilidade
		lineageTag: 74d7f714-8978-5d56-b5bf-90984cf28fc3

	/// Placas por hora de máquina rodando (só máquinas KE, que informam tempos).
	measure 'Placas por Hora Rodando' = DIVIDE ( CALCULATE ( [Placas Processadas], Maquina[InformaTempos] = "Sim" ), [Horas Rodando] )
		formatString: #,0.0
		displayFolder: Produção
		lineageTag: 8e6ace2d-3c0f-51e4-bf60-896e9ee8c01d

	measure 'Reinícios de Contador' = SUM ( Leitura[Reinicio] )
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: 1bddecc0-a555-5b2c-a63b-6dcdd03aab87

	measure Leituras = COUNTROWS ( Leitura )
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: e370dbe2-629b-5ced-b565-85fd6266689b

	/// Placas × ciclo de referência ÷ tempo rodando, limitado a 100%. O ciclo é a TAXA DEMONSTRADA (CicloIdeal), não um padrão de engenharia.
	measure 'Desempenho %' = VAR d = DIVIDE ( CALCULATE ( SUM ( Leitura[TempoIdeal] ), Leitura[TemCiclo] = 1 ), CALCULATE ( SUM ( Leitura[TempoRodando] ), Leitura[TemCiclo] = 1 ) ) RETURN IF ( ISBLANK ( d ), BLANK (), MIN ( 1, d ) )
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: acb411d8-826b-5009-87c3-92f8214f4ec4

	/// Disponibilidade × Desempenho. Não há dado de placas aprovadas/reprovadas, então a qualidade fica de fora (equivale a 100%).
	measure 'OEE % (sem qualidade)' = [Disponibilidade %] * [Desempenho %]
		formatString: 0.0%
		displayFolder: OEE
		lineageTag: d200fcd8-bd81-5c80-b33a-ac15bff67efe

