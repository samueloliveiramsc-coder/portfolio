/// Pick/perda por feeder, agregado por hora.
table Feeder
	lineageTag: 50f33b7f-43fb-541f-8517-6554bcb910b8

	measure 'Picked (feeders)' = SUM ( Feeder[Picked] )
		formatString: #,0
		displayFolder: Perdas
		lineageTag: 86cfb577-de37-5af7-b6f3-c19a14ac99cd

	measure 'Missed (feeders)' = SUM ( Feeder[Missed] )
		formatString: #,0
		displayFolder: Perdas
		lineageTag: a16177c9-433e-590a-950b-aeb0723e28fb

	/// Missed ÷ Picked nos feeders.
	measure 'Taxa de Perda %' = DIVIDE ( [Missed (feeders)], [Picked (feeders)] )
		formatString: 0.00%
		displayFolder: Perdas
		lineageTag: fccfb8b8-421c-5f85-86ff-30f92148f4d9

	/// Perdas por milhão de picks.
	measure 'Perdas PPM' = [Taxa de Perda %] * 1000000
		formatString: #,0
		displayFolder: Perdas
		lineageTag: 7050f185-5c41-521b-970c-d39923e9c3cf

