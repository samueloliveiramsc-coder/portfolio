/// Ocorrências por motivo de perda. Um pick perdido pode ter mais de um motivo: não somar com Missed.
table PerdaMotivo
	lineageTag: 33f29040-62fd-5413-977e-368f572e425e

	measure 'Ocorrências de Perda' = SUM ( PerdaMotivo[Ocorrencias] )
