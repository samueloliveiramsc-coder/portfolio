/// Foto atual de cada máquina (coleção SPEND).
table StatusAtual
	lineageTag: 2fc314ba-44b9-5416-bf5b-a43ec262ca1a

	measure Máquinas = COUNTROWS ( StatusAtual )
		formatString: #,0
		displayFolder: Status
		lineageTag: 14e48f86-9db3-59a5-9206-c909ca5bd35f

	measure 'Máquinas com Coleta OK' = SUM ( StatusAtual[ColetaOk] )
		formatString: #,0
		displayFolder: Status
		lineageTag: 12f9a646-184e-5ac0-94e1-7a4fad5bdfe5

	measure '% Máquinas com Coleta OK' = DIVIDE ( [Máquinas com Coleta OK], [Máquinas] )
		formatString: 0%
		displayFolder: Status
		lineageTag: 2b182f26-b57f-5733-b232-eac0f917d245

	column MaquinaKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7bd41fbe-8fb0-56dc-a37c-0803eb0f9736
		summarizeBy: none
		sourceColumn: MaquinaKey

		annotation SummarizationSetBy = Automatic

	column ProgramaAtual
