/// Tempos informados pelas máquinas KE. As causas de parada se sobrepõem: não somar entre categorias.
table TempoMaquina
	lineageTag: 1f1d5ec2-ec41-513f-921b-61c85c8c4ff6

	measure 'Horas por Categoria' = DIVIDE ( SUM ( TempoMaquina[Segundos] ), 3600 )
		formatString: #,0.0
		displayFolder: Disponibilidade
		lineageTag: 85001e10-430b-5cb7-91c4-c3abe819070e

	column MaquinaKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 96e6705c-e5e3-538a-b790-df7690d1ff59
		summarizeBy: none
		sourceColumn: MaquinaKey

		annotation SummarizationSetBy = Automatic

