model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Servidor", "Banco", "Maquina", "Programa", "Componente", "Calendario", "Hora", "Leitura", "Feeder", "PerdaMotivo", "TempoMaquina", "TrocaPrograma", "Evento", "StatusAtual", "FalhaMaquina", "CicloIdeal"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Maquina
ref table Programa
ref table Componente
ref table Calendario
ref table Hora
ref table Leitura
ref table Feeder
ref table PerdaMotivo
ref table TempoMaquina
ref table TrocaPrograma
ref table Evento
ref table StatusAtual
ref table FalhaMaquina
ref table CicloIdeal

