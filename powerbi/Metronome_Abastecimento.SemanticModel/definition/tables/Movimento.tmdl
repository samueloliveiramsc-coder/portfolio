/// Movimentos de bobinas por hora, destino e operador.
table Movimento
	lineageTag: 0862d054-a8bb-5d55-81b6-0fb4c17aa168

	measure Movimentos = SUM ( Movimento[QtdMovimentos] )
		formatString: #,0
		displayFolder: Movimentos
		lineageTag: fbb98741-3df4-5bfd-afda-86cfe81536c1

	/// Mesma bobina e destino em menos de 60 s (leitura duplicada).
	measure 'Movimentos Repetidos' = SUM ( Movimento[QtdRepetidos] )
		formatString: #,0
		displayFolder: Movimentos
		lineageTag: 0af202cb-61e0-583f-90fc-db9560b054e3

	measure '% Movimentos Repetidos' = DIVIDE ( [Movimentos Repetidos], [Movimentos] )
		formatString: 0.0%
		displayFolder: Movimentos
		lineageTag: b9ce68a2-53e3-5b1a-a402-124f1dd16d09

	column DataKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 37457c5b-c1fd-5588-8073-7e5a70602107
