		sourceColumn: Lado

		annotation SummarizationSetBy = Automatic

	partition EventoMaquina = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "bi", Item = "EventoMaquina"]}[Data]
				in
				    Dados

	annotation PBI_ResultType = Table

