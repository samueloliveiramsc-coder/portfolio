/// Conferências de setup (PlanAudit): duração do 1º feeder lido ao último confirmado.
table Setup
	lineageTag: 68f799cf-ed7d-5c98-940c-d290f47fbde7

	measure Setups = COUNTROWS ( Setup )
		formatString: #,0
		displayFolder: Setup
		lineageTag: 5c4d6c26-c920-565c-b3f9-27b4be138986

	measure 'Programas Conferidos' = DISTINCTCOUNT ( Setup[ProgramaKey] )
		formatString: #,0
		displayFolder: Setup
		lineageTag: 6a49247b-649b-51a9-8ad6-93794ad0150d

	measure 'Feeders Conferidos' = SUM ( Setup[FeedersConferidos] )
		formatString: #,0
		displayFolder: Setup
		lineageTag: 9afcf502-fc68-5497-9cd5-968e3ab9e49d

	measure 'Feeders por Setup' = DIVIDE ( SUM ( Setup[Feeders] ), [Setups] )
		formatString: #,0.0
		displayFolder: Setup
		lineageTag: 091e7038-39d6-5f5f-ab64-ee58aa0941e1

	/// Mediana da duração; conferências sem feeders ou acima de 1 h ficam de fora.
	measure 'Tempo Mediano de Conferência (min)' = CALCULATE ( MEDIAN ( Setup[DuracaoMin] ), Setup[DuracaoValida] = 1 )
		formatString: #,0.0
		displayFolder: Setup
		lineageTag: 5de6a8d9-d547-5d20-9168-98974f4e9ae9

	measure 'Tempo Médio de Conferência (min)' = CALCULATE ( AVERAGE ( Setup[DuracaoMin] ), Setup[DuracaoValida] = 1 )
		formatString: #,0.0
		displayFolder: Setup
		lineageTag: 22c0a896-6815-5962-ab32-d1b09a94cd28

	/// Sem feeders ou acima de 1 h (sessão esquecida aberta).
	measure 'Conferências Fora do Padrão' = CALCULATE ( [Setups], Setup[DuracaoValida] = 0 )
		formatString: #,0
		displayFolder: Setup
		lineageTag: 250ed618-f1e7-575d-9884-2ac68a0c6ac1

	column SetupId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 445ec8c6-8d92-5d7f-9b05-82cdefe089a3
		summarizeBy: none
		sourceColumn: SetupId

		annotation SummarizationSetBy = Automatic

	column DataHora
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		lineageTag: beb3c5c9-4b41-57f6-b2ae-7ce1bd2147ec
