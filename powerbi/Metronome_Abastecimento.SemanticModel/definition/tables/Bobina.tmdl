/// Foto atual de cada bobina: saldo, local, dias sem movimento. A data é a de recebimento.
table Bobina
	lineageTag: e522fe65-e01e-5634-8a5e-db06ea47b7d4

	/// Foto atual: não depende do período.
	measure 'Bobinas com Saldo' = CALCULATE ( COUNTROWS ( Bobina ), Bobina[Situacao] = "Com saldo", REMOVEFILTERS ( Calendario ) )
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 1fc73d91-8499-5460-9a8a-adfc53ea5c6f

	/// Foto atual: não depende do período.
	measure 'Peças em Estoque' = CALCULATE ( SUM ( Bobina[Saldo] ), Bobina[Situacao] = "Com saldo", REMOVEFILTERS ( Calendario ) )
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 2601dad0-6c18-5f5c-bfcc-83b83315e3ef

	/// Com saldo e sem movimento há mais de PARADA_DIAS (padrão 90) em relação à data de corte.
	measure 'Bobinas Paradas' = CALCULATE ( COUNTROWS ( Bobina ), Bobina[Situacao] = "Com saldo", REMOVEFILTERS ( Calendario ), Bobina[Parada] = 1 )
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 0cfc25a8-de6f-549c-a85a-b496f0e333fc

	measure '% Bobinas Paradas' = DIVIDE ( [Bobinas Paradas], [Bobinas com Saldo] )
		formatString: 0.0%
		displayFolder: Estoque
		lineageTag: 20fafc38-9e8e-560e-a936-10f616647fa0

	/// Pela data de recebimento.
	measure 'Bobinas Recebidas' = COUNTROWS ( Bobina )
		formatString: #,0
		displayFolder: Estoque
		lineageTag: 99224aee-f889-5e5d-b11b-95d691abc79f

	/// Recebimento até a primeira montagem em máquina, pela data de recebimento.
	measure 'Dias até Montar (mediana)' = MEDIAN ( Bobina[DiasAteMontar] )
		formatString: #,0.0
		displayFolder: Estoque
		lineageTag: fe09faa0-bda5-52ee-8d9e-c2d4384d331e

	measure 'Dias até Montar (média)' = AVERAGE ( Bobina[DiasAteMontar] )
		formatString: #,0.0
		displayFolder: Estoque
		lineageTag: 8e0682cf-298d-5631-8d62-f05699b6424c

