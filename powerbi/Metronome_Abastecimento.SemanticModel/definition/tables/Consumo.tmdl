/// Queda do saldo das bobinas entre movimentos, por hora, máquina e componente. Origem 'Fora da máquina' = baixa de estoque.
table Consumo
	lineageTag: 4da74300-2b6c-526b-8370-4f6ed0bfd2c6

	/// Queda do saldo das bobinas que passaram por máquina. Data = movimento que registrou o novo saldo.
	measure 'Consumo (peças)' = CALCULATE ( SUM ( Consumo[Quantidade] ), Consumo[Origem] = "Em máquina" )
		formatString: #,0
		displayFolder: Consumo
		lineageTag: 7004eafe-90df-57d5-a382-3edaa0c9ffdf

	/// Por dia com consumo.
	measure 'Consumo Médio por Dia' = DIVIDE ( [Consumo (peças)], CALCULATE ( DISTINCTCOUNT ( Consumo[DataKey] ), Consumo[Origem] = "Em máquina" ) )
		formatString: #,0
		displayFolder: Consumo
		lineageTag: 3d91b1ed-02a3-5e06-a575-bf77e836360f

	measure 'Bobinas Esgotadas' = CALCULATE ( SUM ( Consumo[BobinasEsgotadas] ), Consumo[Origem] = "Em máquina" )
		formatString: #,0
		displayFolder: Consumo
		lineageTag: 0feb143f-68cb-59be-b6ab-5b0d0bfde81b

	measure 'Componentes Consumidos' = CALCULATE ( DISTINCTCOUNT ( Consumo[ComponenteKey] ), Consumo[Origem] = "Em máquina" )
		formatString: #,0
		displayFolder: Consumo
		lineageTag: 9f2bafe4-6abe-5980-a1ed-938b49c22ded

	/// Quedas de saldo sem a bobina ter saído de uma máquina: baixa no almoxarifado, kit ou caixa.
	measure 'Baixas Fora da Máquina (peças)' = CALCULATE ( SUM ( Consumo[Quantidade] ), Consumo[Origem] = "Fora da máquina" )
		formatString: #,0
		displayFolder: Consumo
		lineageTag: 09e5ca80-e6ab-5b16-8688-d9342c7afcda

	column DataKey
		dataType: int64
		isHidden
		formatString: 0
