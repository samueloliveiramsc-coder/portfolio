    <DTS:Executable
      DTS:refId="Package\SQL - Iniciar carga"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Abre a carga em etl.Carga, limpa a staging e devolve CargaId e o filtro incremental."
      DTS:DTSID="{DB7C5DA7-1D63-4060-B9F0-0DE0508D708A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
