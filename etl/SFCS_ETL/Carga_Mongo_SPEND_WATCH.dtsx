          DTS:LocaleID="-1"
          DTS:ObjectName="SQL - Registrar falha">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"EXEC etl.usp_RegistrarFalha @CargaId = " + (DT_WSTR, 12) @[User::CargaId] + ", @Mensagem = N'" + REPLACE(SUBSTRING(@[System::SourceName] + ": " + @[System::ErrorDescription], 1, 3500), "'", "''") + "'"</DTS:PropertyExpression>
