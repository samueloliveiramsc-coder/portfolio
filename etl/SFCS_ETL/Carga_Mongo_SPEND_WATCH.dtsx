      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="SqlStatementSource">"EXEC etl.usp_IniciarCarga @MongoDatabase = N'" + @[$Project::MongoDatabase] + "'"</DTS:PropertyExpression>
