        <SQLTask:SqlTaskData
          SQLTask:Connection="{76513A7C-8D88-4B60-BD18-563B1BCE7C07}"
          SQLTask:SqlStatementSource="EXEC etl.usp_IniciarCarga @MongoDatabase = N'thread_05'"
